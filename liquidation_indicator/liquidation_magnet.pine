// ════════════════════════════════════════════════════════════════════════════
//  WHALE LIQUIDATION MAGNET  ·  non-repaint  ·  built for TradingView mobile (vertical)
// ────────────────────────────────────────────────────────────────────────────
//  Idea (think like an exchange / whale):
//   Every leveraged trader has a liquidation price. Big players and exchanges can
//   see where most of that money sits. Pushing price into the BIGGEST pile of
//   liquidations gives them cheap fills and forced orders. So price tends to move
//   toward the side with MORE liquidation money ("magnet").
//
//  How the map is built (closed bars only -> never repaints):
//   1) Open Interest goes UP on a bar  -> new positions opened at that bar's price.
//   2) Their liquidation prices (10x / 25x / 50x / 100x) are stored as zones:
//        ORANGE = longs get liquidated there (below price)
//        CYAN   = shorts get liquidated there (above price)
//   3) Price touches a zone -> those traders are gone -> zone deleted.
//      Open Interest goes DOWN -> all zones shrink.
//   4) Inside ±range%: short-liq money above ≥ ratio × long-liq money below -> BUY
//                      long-liq money below ≥ ratio × short-liq money above -> SELL
//   5) Target / Stop = ATR based. Built-in backtest table shows real results on
//      whatever timeframe you open. Tap a BUY/SELL label to read the full reason.
//
//  Data: TradingView open interest symbol "<EXCHANGE>:<TICKER>_OI"
//        (e.g. BINANCE:BTCUSDT.P_OI). Liquidation zones are ESTIMATES.
//  Tested in Python on OKX BTC perp 15m (15 days, 153 trades): 54.9% win,
//  ≈ breakeven after 0.05% taker fee, profitable with 0.02% maker fee. Not advice.
// ════════════════════════════════════════════════════════════════════════════
//@version=5
indicator("Whale Liquidation Magnet", shorttitle="🐋 LiqMagnet", overlay=true,
     max_boxes_count=500, max_lines_count=100, max_labels_count=500, max_bars_back=500)

// ───────── inputs ─────────
g1 = "Account"
balance  = input.float(1000, "Start balance $", group=g1)
riskPct  = input.float(1.0, "Risk per trade %", minval=0.1, step=0.1, group=g1)
feePct   = input.float(0.05, "Fee per side % (taker 0.05 / maker 0.02)", step=0.01, group=g1)
maxLev   = input.float(20, "Max leverage allowed", group=g1)
g2 = "Signals"
ratio    = input.float(3.0, "Magnet strength (x more money on one side)", minval=1.2, step=0.1, group=g2)
rngPct   = input.float(2.0, "Look ±% around price", step=0.5, group=g2)
tpAtr    = input.float(1.5, "Target = ATR ×", step=0.1, group=g2)
slAtr    = input.float(1.5, "Stop = ATR ×", step=0.1, group=g2)
g3 = "Liquidation map"
oiSymIn  = input.string("", "Open Interest symbol (blank = auto)", group=g3)
binPct   = input.float(0.10, "Zone size %", minval=0.02, step=0.02, group=g3)
mmPct    = input.float(0.40, "Maintenance margin %", step=0.1, group=g3)
maxZones = input.int(400, "Zones kept in memory", maxval=1500, group=g3)
showN    = input.int(30, "Zones drawn", maxval=150, group=g3)
g4 = "Look"
showZones = input.bool(true, "Show liquidation zones", group=g4)
showPos   = input.bool(true, "Show trade boxes (target / stop)", group=g4)
keepPos   = input.int(25, "Trade boxes kept", maxval=100, group=g4)
showProj  = input.bool(true, "Show magnet projection", group=g4)
projBars  = input.int(25, "Projection length (bars)", group=g4)
showTable = input.bool(true, "Show results table", group=g4)
tblPos    = input.string("Top right", "Table position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=g4)

cLong  = color.rgb(255, 152, 0)
cShort = color.rgb(0, 229, 255)
cBuy   = color.rgb(38, 166, 154)
cSell  = color.rgb(239, 83, 80)

// ───────── open interest ─────────
oiSym = oiSymIn == "" ? syminfo.prefix + ":" + syminfo.ticker + "_OI" : oiSymIn
oi    = request.security(oiSym, timeframe.period, close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
atr   = ta.atr(14)

// ───────── liquidation map ─────────
var float[] zPx   = array.new_float()
var float[] zUsd  = array.new_float()
var int[]   zSide = array.new_int()     // 1 = long liq (below), -1 = short liq (above)
var float   step  = na
if na(step)
    step := close * binPct / 100

addZone(side, px, usd) =>
    k = math.round(px / step) * step
    found = false
    n = array.size(zPx)
    if n > 0
        for i = 0 to n - 1
            if array.get(zSide, i) == side and array.get(zPx, i) == k
                array.set(zUsd, i, array.get(zUsd, i) + usd)
                found := true
                break
    if not found
        array.push(zPx, k)
        array.push(zUsd, usd)
        array.push(zSide, side)

fmtM(x) => x >= 1e9 ? str.tostring(x / 1e9, "#.##") + "B" : x >= 1e6 ? str.tostring(x / 1e6, "#.#") + "M" : str.tostring(x / 1e3, "#") + "K"
pct(x) => str.tostring(x, "#.##") + "%"

// ───────── backtest state ─────────
var int   tDir = 0
var float tEntry = na
var float tTp = na
var float tSl = na
var int   tBar = na
var float tPos = na
var box   tBoxTp = na
var box   tBoxSl = na
var box[] oldBoxes = array.new_box()
var int   nTrades = 0
var int   nWins = 0
var float grossWin = 0.0
var float grossLoss = 0.0
var float equity = na
var float peak = na
var float maxDD = 0.0
var float sumRet = 0.0
if na(equity)
    equity := balance
    peak := balance

float upUsd = 0.0
float dnUsd = 0.0
float upTgt = na
float dnTgt = na
buySig  = false
sellSig = false
var int lastSide = 0

if barstate.isconfirmed and not na(oi) and not na(oi[1])
    // 1) manage open trade (SL first if both touched in one bar = conservative)
    if tDir != 0 and bar_index > tBar
        hitSl = tDir == 1 ? low <= tSl : high >= tSl
        hitTp = tDir == 1 ? high >= tTp : low <= tTp
        if hitSl or hitTp
            ex   = hitSl ? tSl : tTp
            ret  = (ex - tEntry) / tEntry * tDir
            pnl  = tPos * ret - tPos * 2 * feePct / 100
            equity += pnl
            nTrades += 1
            sumRet += pnl
            if pnl > 0
                nWins += 1
                grossWin += pnl
            else
                grossLoss -= pnl
            peak := math.max(peak, equity)
            maxDD := math.max(maxDD, (peak - equity) / peak * 100)
            if not na(tBoxTp)
                box.set_right(tBoxTp, bar_index)
                box.set_right(tBoxSl, bar_index)
            label.new(bar_index, ex, hitTp ? "✅ " + pct(math.abs(ret) * 100) : "❌ -" + pct(math.abs(ret) * 100),
                      style=label.style_none, textcolor=hitTp ? cBuy : cSell, size=size.small)
            tDir := 0
    else if tDir != 0 and not na(tBoxTp)
        box.set_right(tBoxTp, bar_index)
        box.set_right(tBoxSl, bar_index)

    // 2) remove liquidated zones
    n = array.size(zPx)
    if n > 0
        for i = n - 1 to 0
            p = array.get(zPx, i)
            s = array.get(zSide, i)
            if (s == 1 and low <= p) or (s == -1 and high >= p)
                array.remove(zPx, i)
                array.remove(zUsd, i)
                array.remove(zSide, i)

    // 3) add / shrink with open interest
    dOi = oi - oi[1]
    hp  = hlc3
    mm  = mmPct / 100
    if dOi > 0
        w   = 0.5 + 0.5 * (high > low ? (close - open) / (high - low) : 0.0)
        lev = array.from(10.0, 25.0, 50.0, 100.0)
        lw  = array.from(0.30, 0.30, 0.25, 0.15)
        for j = 0 to 3
            L  = array.get(lev, j)
            fw = array.get(lw, j)
            addZone(1,  hp * (1 - 1 / L + mm), dOi * w * fw)
            addZone(-1, hp * (1 + 1 / L - mm), dOi * (1 - w) * fw)
    else if dOi < 0 and oi[1] > 0
        f  = math.max(0.0, 1 + dOi / oi[1])
        n2 = array.size(zUsd)
        if n2 > 0
            for i = 0 to n2 - 1
                array.set(zUsd, i, array.get(zUsd, i) * f)
    while array.size(zUsd) > maxZones
        idx = array.indexof(zUsd, array.min(zUsd))
        array.remove(zPx, idx)
        array.remove(zUsd, idx)
        array.remove(zSide, idx)

    // 4) magnet: money above vs below
    float bestUp = 0.0
    float bestDn = 0.0
    n3 = array.size(zPx)
    if n3 > 0
        for i = 0 to n3 - 1
            p = array.get(zPx, i)
            u = array.get(zUsd, i)
            if array.get(zSide, i) == -1 and p <= close * (1 + rngPct / 100)
                upUsd += u
                if u > bestUp
                    bestUp := u
                    upTgt := p
            if array.get(zSide, i) == 1 and p >= close * (1 - rngPct / 100)
                dnUsd += u
                if u > bestDn
                    bestDn := u
                    dnTgt := p
    side = upUsd > ratio * dnUsd and upUsd > 0 ? 1 : dnUsd > ratio * upUsd and dnUsd > 0 ? -1 : 0
    if tDir == 0 and side != 0 and not na(atr)
        buySig  := side == 1
        sellSig := side == -1
        tDir   := side
        tEntry := close
        tTp    := close + side * tpAtr * atr
        tSl    := close - side * slAtr * atr
        tBar   := bar_index
        slP     = slAtr * atr / close * 100
        tpP     = tpAtr * atr / close * 100
        tPos   := math.min(equity * riskPct / slP, equity * maxLev)
        levX    = tPos / equity
        mine    = side == 1 ? upUsd : dnUsd
        other   = side == 1 ? dnUsd : upUsd
        tgtZ    = side == 1 ? upTgt : dnTgt
        shortTxt = (side == 1 ? "BUY\n🧲 $" + fmtM(mine) + " shorts above" : "SELL\n🧲 $" + fmtM(mine) + " longs below")
        reason = (side == 1 ? "🟢 BUY — Whale Magnet UP\n\n" : "🔴 SELL — Whale Magnet DOWN\n\n") +
                 "💰 $" + fmtM(mine) + (side == 1 ? " of SHORT traders get liquidated if price goes up " : " of LONG traders get liquidated if price goes down ") + pct(rngPct) + ".\n" +
                 "⚖️ Only $" + fmtM(other) + " on the other side (" + str.tostring(other > 0 ? mine / other : 99, "#.#") + "x less).\n" +
                 "🐋 Whales / exchanges earn most by pushing price into the bigger pile, so the move is more likely " + (side == 1 ? "UP" : "DOWN") + ".\n" +
                 "🎯 Biggest pile at " + str.tostring(tgtZ, format.mintick) + "\n\n" +
                 "✅ Target " + str.tostring(tTp, format.mintick) + " (" + (side == 1 ? "+" : "-") + pct(tpP) + ")\n" +
                 "❌ Stop " + str.tostring(tSl, format.mintick) + " (" + (side == 1 ? "-" : "+") + pct(slP) + ")\n" +
                 "📦 Size $" + str.tostring(tPos, "#,###") + " · leverage " + str.tostring(levX, "#.#") + "x · risk " + pct(riskPct) + " ($" + str.tostring(equity * riskPct / 100, "#.##") + ")"
        label.new(bar_index, side == 1 ? low : high, shortTxt, style=side == 1 ? label.style_label_up : label.style_label_down,
                  color=side == 1 ? cBuy : cSell, textcolor=color.white, size=size.small, tooltip=reason)
        if showPos
            if not na(tBoxTp)
                array.push(oldBoxes, tBoxTp)
                array.push(oldBoxes, tBoxSl)
            tBoxTp := box.new(bar_index, math.max(tEntry, tTp), bar_index + 1, math.min(tEntry, tTp), border_color=color.new(cBuy, 40),
                              bgcolor=color.new(cBuy, 80), text="TARGET " + (side == 1 ? "+" : "-") + pct(tpP), text_color=color.new(color.white, 10),
                              text_size=size.tiny, text_halign=text.align_left, text_valign=side == 1 ? text.align_top : text.align_bottom)
            tBoxSl := box.new(bar_index, math.max(tEntry, tSl), bar_index + 1, math.min(tEntry, tSl), border_color=color.new(cSell, 40),
                              bgcolor=color.new(cSell, 80), text="STOP " + (side == 1 ? "-" : "+") + pct(slP), text_color=color.new(color.white, 10),
                              text_size=size.tiny, text_halign=text.align_left, text_valign=side == 1 ? text.align_bottom : text.align_top)
            while array.size(oldBoxes) > keepPos * 2
                box.delete(array.shift(oldBoxes))

alertcondition(buySig,  "🐋 BUY",  "Whale Magnet BUY {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSig, "🐋 SELL", "Whale Magnet SELL {{ticker}} {{interval}} @ {{close}}")

// ───────── zones + projection (drawn on last bar only) ─────────
var box[] zoneBoxes = array.new_box()
var line  pLine = na
var label pLab  = na
if barstate.islast
    for b in zoneBoxes
        box.delete(b)
    array.clear(zoneBoxes)
    n = array.size(zUsd)
    if showZones and n > 0
        mx   = array.max(zUsd)
        idxs = array.sort_indices(zUsd, order.descending)
        for k = 0 to math.min(showN, n) - 1
            i  = array.get(idxs, k)
            p  = array.get(zPx, i)
            u  = array.get(zUsd, i)
            isL = array.get(zSide, i) == 1
            c  = isL ? cLong : cShort
            tr = int(90 - 55 * u / mx)
            array.push(zoneBoxes, box.new(bar_index - 40, p + step / 2, bar_index + projBars, p - step / 2,
                         border_color=color.new(c, 100), bgcolor=color.new(c, tr),
                         text=u > mx * 0.3 ? "$" + fmtM(u) + (isL ? " longs ↓" : " shorts ↑") : "",
                         text_color=color.new(c, 10), text_size=size.tiny, text_halign=text.align_right))
    line.delete(pLine)
    label.delete(pLab)
    if showProj and n > 0
        up = 0.0
        dn = 0.0
        float tu = na
        float td = na
        float bu = 0.0
        float bd = 0.0
        for i = 0 to n - 1
            p = array.get(zPx, i)
            u = array.get(zUsd, i)
            if math.abs(p - close) / close <= rngPct / 100
                if array.get(zSide, i) == -1
                    up += u
                    if u > bu
                        bu := u
                        tu := p
                else
                    dn += u
                    if u > bd
                        bd := u
                        td := p
        tgt = up >= dn ? tu : td
        if not na(tgt)
            pLine := line.new(bar_index, close, bar_index + projBars, tgt, color=color.new(color.white, 60), style=line.style_dotted, width=2)
            pLab  := label.new(bar_index + projBars, tgt, "🧲 " + str.tostring(tgt, format.mintick), style=label.style_label_left,
                               color=color.new(color.white, 88), textcolor=color.new(color.white, 25), size=size.small,
                               tooltip="Magnet: biggest liquidation pile within ±" + pct(rngPct) + ". Up $" + fmtM(up) + " vs down $" + fmtM(dn) + ". Guide only, not a prediction.")

// ───────── results table (small, mobile friendly) ─────────
pos = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : position.bottom_left
var table tb = table.new(pos, 2, 9, bgcolor=color.new(#131722, 15), border_color=color.new(#363a45, 0), border_width=1, frame_color=color.new(#363a45, 0), frame_width=1)
row(r, k, v, vc) =>
    table.cell(tb, 0, r, k, text_color=color.new(color.white, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)
if barstate.islast and showTable
    wr  = nTrades > 0 ? nWins / nTrades * 100 : 0.0
    pf  = grossLoss > 0 ? grossWin / grossLoss : na
    net = (equity - balance) / balance * 100
    table.cell(tb, 0, 0, "🐋 BACKTEST " + timeframe.period, text_color=color.white, text_size=size.tiny, bgcolor=color.new(#2962ff, 40))
    table.cell(tb, 1, 0, na(oi) ? "⚠️ no OI data" : syminfo.ticker, text_color=color.white, text_size=size.tiny, bgcolor=color.new(#2962ff, 40))
    row(1, "Trades", str.tostring(nTrades) + (nTrades < 100 ? " (few)" : ""), color.white)
    row(2, "Win rate", pct(wr), wr >= 50 ? cBuy : cSell)
    row(3, "Profit factor", na(pf) ? "-" : str.tostring(pf, "#.##"), na(pf) or pf >= 1 ? cBuy : cSell)
    row(4, "Net", (net >= 0 ? "+" : "") + pct(net), net >= 0 ? cBuy : cSell)
    row(5, "Max drawdown", "-" + pct(maxDD), cSell)
    row(6, "$" + str.tostring(balance, "#") + " →", "$" + str.tostring(equity, "#,###.##"), equity >= balance ? cBuy : cSell)
    row(7, "Risk/trade", pct(riskPct) + " = $" + str.tostring(equity * riskPct / 100, "#.##"), color.white)
    row(8, "Fee/side", pct(feePct), color.white)
